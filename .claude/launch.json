{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-build",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5180",
        "--directory",
        "build/web"
      ],
      "port": 5180
    },
    {
      "name": "screenshots-editor",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd store/screenshots-editor && PATH=$HOME/.nvm/versions/node/v22.22.2/bin:$PATH exec npm run dev -- -p 3005"
      ],
      "port": 3005
    }
  ]
}
